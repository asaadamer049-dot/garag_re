# Database connection URL (Local SQLite for On-Premises)
DATABASE_URL="file:./fleet_erp.db"

# Session Security & JWT Secret (Ensure 32+ characters in production)
JWT_SECRET="fleet-erp-onprem-super-secret-key-change-in-production-2026"

# Server configuration
PORT=3000
NODE_ENV="development"
APP_NAME="نظام إدارة أسطول النقل والمركبات"
APP_URL="http://localhost:3000"

# Local Storage Directory for Attachments
STORAGE_PATH="./uploads"
